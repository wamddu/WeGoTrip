# Copy to .env.local. Restart Metro after changing these values.
EXPO_PUBLIC_DATA_SOURCE=mock
# Used only when DATA_SOURCE=http; never put secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# Optional XYZ raster provider. Set the matching attribution when replacing it.
EXPO_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
EXPO_PUBLIC_MAP_ATTRIBUTION=© OpenStreetMap contributors
EXPO_PUBLIC_MAP_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright
