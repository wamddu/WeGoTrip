# Copy to .env.local. Restart Metro after changing these values.
EXPO_PUBLIC_DATA_SOURCE=http
# Used only when DATA_SOURCE=http; never put secrets in EXPO_PUBLIC variables.
EXPO_PUBLIC_API_URL=http://localhost:8080/api
# Android Studio emulator: keep localhost and run adb reverse tcp:8080 tcp:8080.
# With multiple devices, use adb -s <device-id> reverse tcp:8080 tcp:8080.
# Reapply after restarting the emulator; see README for the Windows SDK path.

# Google Maps proxy base URL (no API key). Works with mock travel data too.
# For a physical phone, replace localhost with your computer's LAN address.
# Alternative: use 10.0.2.2 in BOTH API URLs and restart Metro (emulator only).
# Restore localhost and restart Metro when switching back to web testing.
EXPO_PUBLIC_MAPS_API_URL=http://localhost:8080/api

# Firebase web client configuration (public, NOT a service-account private key).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
EXPO_PUBLIC_FIREBASE_VAPID_KEY=

# Native defaults: ./google-services.json and ./GoogleService-Info.plist.
# GOOGLE_SERVICES_JSON=./google-services.json
# GOOGLE_SERVICES_PLIST=./GoogleService-Info.plist
IOS_BUNDLE_IDENTIFIER=your.registered.bundle.identifier
