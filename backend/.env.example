DB_URL=jdbc:mysql://localhost:3306/travel
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password
DB_DDL_AUTO=validate

# HTTPS deployments: true. Set false only for local HTTP development.
AUTH_COOKIE_SECURE=false

# USER API: separate Base64-encoded random keys; never reuse the Google key.
# JWT: at least 32 bytes, shared with the future Auth issuer.
USER_JWT_SECRET=
# Bank account encryption: exactly 32 bytes; retain securely to decrypt existing values.
USER_BANK_ENCRYPTION_KEY=
users.jwt-issuer=wegotrip-auth
users.jwt-audience=wegotrip-api
users.consent-version=1.0

# Enable Places API (New) and Maps Static API on this key's Google Cloud project.
GOOGLE_MAPS_API_KEY=
# Use comma-separated exact web origins. Native apps are not subject to CORS.
maps.allowed-origins=http://localhost:8081,http://localhost:8082
